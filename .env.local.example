# ==========================================
# 대리기사 AI 가이드 에이전트 (콜나비 CallNavi) 환경 변수 설정
# ==========================================

# 1. Firebase Client Configuration (클라이언트 사이드)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=callnavi-driver.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=callnavi-driver
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=callnavi-driver.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# 2. 지도 및 교통 API (추후 연동)
NEXT_PUBLIC_KAKAO_MAP_API_KEY=your_kakao_javascript_key_here

# 3. Firebase Admin SDK (서버 사이드 - 옵션)
# FIREBASE_ADMIN_PROJECT_ID=callnavi-driver
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@callnavi-driver.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
